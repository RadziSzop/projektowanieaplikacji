{
  "name": "@app/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:setup": "prisma db push --skip-generate && node prisma/seed.js",
    "start": "npm run db:setup && node dist/index.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "express": "^5.1.0",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
