generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int    @id
  name        String
  description String
  price       Int
  features    Json
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  password     String
  session      String?   @unique
  sessionUntil DateTime?
}

model Order {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  address   String
  city      String
  postcode  String
  total     Int
  items     Json
  createdAt DateTime @default(now())
}
